# Contact form (Mailjet Send API v3.1). Copy to .env.local for development.
# API keys: https://app.mailjet.com/account/apikeys
MAILJET_API_KEY=
MAILJET_API_SECRET=
# Sender address: must be a validated sender or domain in your Mailjet account.
CONTACT_FROM_EMAIL=noreply@loicortola.com
# Where contact messages are delivered.
CONTACT_TO_EMAIL=you@example.com
